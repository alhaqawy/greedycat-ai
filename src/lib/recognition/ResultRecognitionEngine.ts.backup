export type GameResult =
  | "corn"
  | "pepper"
  | "tomato"
  | "carrot"
  | "shrimp"
  | "fish"
  | "cow"
  | "chick";

export interface RecognizedResult {
  result: GameResult | null;
  confidence: number;
  method: "visual" | "unknown";
  success: boolean;
}

export const GAME_RESULTS: {
  id: GameResult;
  name: string;
  emoji: string;
  multiplier: number;
}[] = [
  { id: "corn", name: "ذرة", emoji: "🌽", multiplier: 5 },
  { id: "pepper", name: "فلفل", emoji: "🌶️", multiplier: 5 },
  { id: "tomato", name: "طماط", emoji: "🍅", multiplier: 5 },
  { id: "carrot", name: "جزر", emoji: "🥕", multiplier: 5 },
  { id: "shrimp", name: "ربيان", emoji: "🦐", multiplier: 10 },
  { id: "fish", name: "سمك", emoji: "🐟", multiplier: 25 },
  { id: "cow", name: "بقر", emoji: "🐄", multiplier: 15 },
  { id: "chick", name: "كتكوت", emoji: "🐔", multiplier: 45 },
];

function imageToCanvas(
  imageData: string,
): Promise<HTMLCanvasElement> {
  return new Promise((resolve, reject) => {
    const image = new Image();

    image.onload = () => {
      const canvas = document.createElement("canvas");
      canvas.width = image.naturalWidth;
      canvas.height = image.naturalHeight;

      const ctx = canvas.getContext("2d");

      if (!ctx) {
        reject(new Error("CANVAS_CONTEXT_FAILED"));
        return;
      }

      ctx.drawImage(image, 0, 0);
      resolve(canvas);
    };

    image.onerror = () => reject(new Error("IMAGE_LOAD_FAILED"));
    image.src = imageData;
  });
}

/**
 * المرحلة الأولى من التعرف البصري.
 *
 * لا يتم اختيار نتيجة عشوائية.
 * إذا لم توجد إشارة بصرية كافية يتم إرجاع null.
 *
 * سيتم توسيع هذا المحرك لاحقًا باستخدام:
 * - ROI
 * - template matching
 * - image features
 * - classifier
 * - نموذج ML
 */
export async function recognizeResult(
  imageData: string,
): Promise<RecognizedResult> {
  if (!imageData) {
    return {
      result: null,
      confidence: 0,
      method: "unknown",
      success: false,
    };
  }

  try {
    const canvas = await imageToCanvas(imageData);

    const ctx = canvas.getContext("2d");

    if (!ctx) {
      return {
        result: null,
        confidence: 0,
        method: "unknown",
        success: false,
      };
    }

    /*
     * منطقة مركز اللعبة.
     *
     * هذه المنطقة ستستخدم لاحقًا لتحليل علامة النتيجة
     * أو العنصر الفائز داخل واجهة GreedyCat.
     */
    const width = canvas.width;
    const height = canvas.height;

    const centerX = Math.floor(width * 0.5);
    const centerY = Math.floor(height * 0.40);

    const roiWidth = Math.floor(width * 0.20);
    const roiHeight = Math.floor(height * 0.16);

    const image = ctx.getImageData(
      Math.max(0, centerX - Math.floor(roiWidth / 2)),
      Math.max(0, centerY - Math.floor(roiHeight / 2)),
      roiWidth,
      roiHeight,
    );

    /*
     * استخراج خصائص بصرية أساسية.
     * لا تستخدم لاتخاذ قرار نهائي حاليًا.
     */
    let brightness = 0;
    let saturation = 0;

    for (let i = 0; i < image.data.length; i += 4) {
      const r = image.data[i];
      const g = image.data[i + 1];
      const b = image.data[i + 2];

      brightness += (r + g + b) / 3;

      const max = Math.max(r, g, b);
      const min = Math.min(r, g, b);

      saturation += max === 0 ? 0 : (max - min) / max;
    }

    const pixels = image.data.length / 4;

    brightness /= pixels;
    saturation /= pixels;

    console.debug("Result ROI features:", {
      width,
      height,
      brightness,
      saturation,
    });

    /*
     * لا يوجد classifier موثوق بعد.
     * لذلك لا نخمن النتيجة.
     */
    return {
      result: null,
      confidence: 0,
      method: "unknown",
      success: false,
    };
  } catch (error) {
    console.error("Result recognition failed:", error);

    return {
      result: null,
      confidence: 0,
      method: "unknown",
      success: false,
    };
  }
}

export function getResultById(
  id: GameResult,
) {
  return GAME_RESULTS.find((result) => result.id === id) ?? null;
}

export function isValidResult(
  value: string,
): value is GameResult {
  return GAME_RESULTS.some((result) => result.id === value);
}
